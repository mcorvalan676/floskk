{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "conectatalento",
  "main": "worker.py",
  "compatibility_date": "2026-09-25",
  "compatibility_flags": ["python_workers"],
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": true
  }
}
