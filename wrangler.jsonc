{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "conectatalento",
  "main": "worker.py",
  "compatibility_date": "2026-09-25",
  "compatibility_flags": ["python_workers"],
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "REPLACE_WITH_HYPERDRIVE_ID"
    }
  ],
  "r2_buckets": [
    {
      "binding": "CV_BUCKET",
      "bucket_name": "conectatalento-cv"
    }
  ],
  "vars": {
    "PHP_SERVICE_URL": "https://REPLACE_WITH_PHP_SERVICE_HOST/servicio.php"
  }
}
